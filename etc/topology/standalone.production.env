# Single-host production profile. Operators may override safe values at install time.
SDKWORK_ENVIRONMENT=production
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_PROFILE_ID=standalone.production
SDKWORK_RUNTIME_TARGET=server
SDKWORK_COMMUNITY_ENVIRONMENT=production
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=standalone
SDKWORK_COMMUNITY_PROFILE_ID=standalone.production
SDKWORK_COMMUNITY_RUNTIME_TARGET=server

COMMUNITY_API_BIND=0.0.0.0:18094
SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18094
SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:18094
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:18094

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai
SDKWORK_DATABASE_SCHEMA=sdkwork_ai
SDKWORK_DATABASE_USERNAME=sdkwork_community
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=32
