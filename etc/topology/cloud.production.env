# Cloud production service profile; credentials are provided by the secret mount.
SDKWORK_ENVIRONMENT=production
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROFILE_ID=cloud.production
SDKWORK_RUNTIME_TARGET=server
SDKWORK_COMMUNITY_ENVIRONMENT=production
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=cloud
SDKWORK_COMMUNITY_PROFILE_ID=cloud.production
SDKWORK_COMMUNITY_RUNTIME_TARGET=server


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COMMUNITY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=https://api.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/community/database-password
SDKWORK_DATABASE_SSL_MODE=verify-full
SDKWORK_DATABASE_MAX_CONNECTIONS=64

# The platform runtime must inject the managed Redis host or URL.
SDKWORK_COMMUNITY_REDIS_ENABLED=true
SDKWORK_COMMUNITY_REDIS_PORT=6379
SDKWORK_COMMUNITY_REDIS_DATABASE=0
SDKWORK_COMMUNITY_REDIS_PASSWORD_FILE=/run/secrets/sdkwork/community/redis-password
SDKWORK_COMMUNITY_REDIS_KEY_PREFIX=sdkwork:community
SDKWORK_COMMUNITY_REDIS_TLS=true
