# Local standalone gateway and client development.
SDKWORK_ENVIRONMENT=development
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_PROFILE_ID=standalone.development
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_COMMUNITY_ENVIRONMENT=development
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=standalone
SDKWORK_COMMUNITY_PROFILE_ID=standalone.development
SDKWORK_COMMUNITY_RUNTIME_TARGET=browser

SDKWORK_COMMUNITY_SERVER_BIND=0.0.0.0:18094
SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18094
VITE_SDKWORK_COMMUNITY_ENVIRONMENT=development
VITE_SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_COMMUNITY_PROFILE_ID=standalone.development
VITE_SDKWORK_COMMUNITY_RUNTIME_TARGET=browser
VITE_SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=/
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD_FILE=.sdkwork/local/secrets/postgres-password
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

SDKWORK_COMMUNITY_REDIS_ENABLED=false
