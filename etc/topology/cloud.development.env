# Remote development APIs; sdkwork-app must not autostart cloud services for this profile.
SDKWORK_ENVIRONMENT=development
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROFILE_ID=cloud.development
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_COMMUNITY_ENVIRONMENT=development
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=cloud
SDKWORK_COMMUNITY_PROFILE_ID=cloud.development
SDKWORK_COMMUNITY_RUNTIME_TARGET=browser


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COMMUNITY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_COMMUNITY_ENVIRONMENT=development
VITE_SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_COMMUNITY_PROFILE_ID=cloud.development
VITE_SDKWORK_COMMUNITY_RUNTIME_TARGET=browser
VITE_SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

VITE_SDKWORK_COMMUNITY_H5_FEEDS_OPEN_API_BASE_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_COMMUNITY_PC_FEEDS_OPEN_API_BASE_URL=https://api-dev.sdkwork.com
