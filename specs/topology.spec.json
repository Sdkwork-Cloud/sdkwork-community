{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-community",
  "applicationCode": "community",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_COMMUNITY_ENVIRONMENT",
    "profileId": "SDKWORK_COMMUNITY_PROFILE_ID",
    "standaloneGatewayBind": "SDKWORK_COMMUNITY_SERVER_BIND",
    "apiGatewayBaseUrl": "SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_COMMUNITY_SERVER_BIND",
      "httpUrlEnv": "SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "components": {
    "applicationServer": {
      "crate": "sdkwork-api-community-standalone-gateway",
      "binary": "sdkwork-api-community-standalone-gateway"
    }
  },
  "cloudPublicHosts": {
    "platform.api-gateway": {
      "httpHost": "api.sdkwork.com"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-community-standalone-gateway",
            "binary": "sdkwork-api-community-standalone-gateway",
            "bindEnv": "SDKWORK_COMMUNITY_SERVER_BIND",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "community-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-community-pc",
            "bindEnv": "SDKWORK_COMMUNITY_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": [
          {
            "id": "community-adaptive-web",
            "applicationRoot": "apps/sdkwork-community-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "community-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-community-pc",
                "script": "dev",
                "defaultPort": 5131,
                "portEnv": "SDKWORK_COMMUNITY_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-community-h5",
                "script": "dev",
                "defaultPort": 5132,
                "portEnv": "SDKWORK_COMMUNITY_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-community-standalone-gateway",
            "binary": "sdkwork-api-community-standalone-gateway",
            "bindEnv": "SDKWORK_COMMUNITY_SERVER_BIND",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [
          {
            "id": "community-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-community-pc",
            "bindEnv": "SDKWORK_COMMUNITY_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ],
        "browserDeliveries": [
          {
            "id": "community-adaptive-web",
            "applicationRoot": "apps/sdkwork-community-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "community-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-community-pc",
                "script": "dev",
                "defaultPort": 5131,
                "portEnv": "SDKWORK_COMMUNITY_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-community-h5",
                "script": "dev",
                "defaultPort": 5132,
                "portEnv": "SDKWORK_COMMUNITY_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "cloud.production": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-community-standalone-gateway",
            "binary": "sdkwork-api-community-standalone-gateway",
            "bindEnv": "SDKWORK_COMMUNITY_SERVER_BIND",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "community-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-community-pc",
            "bindEnv": "SDKWORK_COMMUNITY_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": [
          {
