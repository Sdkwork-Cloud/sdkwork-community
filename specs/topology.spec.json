            "applicationRoot": "apps/sdkwork-community-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "community-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-community-pc",
                "script": "dev",
                "defaultPort": 5131,
                "portEnv": "SDKWORK_COMMUNITY_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-community-h5",
                "script": "dev",
                "defaultPort": 5132,
                "portEnv": "SDKWORK_COMMUNITY_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "standalone.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-community-standalone-gateway",
            "binary": "sdkwork-api-community-standalone-gateway",
            "bindEnv": "SDKWORK_COMMUNITY_SERVER_BIND",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.test": {
        "processes": [
          {
            "id": "community-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-community-pc",
            "bindEnv": "SDKWORK_COMMUNITY_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ],
        "browserDeliveries": [
          {
            "id": "community-adaptive-web",
            "applicationRoot": "apps/sdkwork-community-pc",
            "clientArchitectures": [
              "pc-web",
