          }
        ]
      },
      "cloud.staging": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      }
    }
  },
  "retired": {
    "notes": "Legacy deploymentProfiles block (serviceLayout unified-process/split-services) removed in favor of schema v5 orchestration."
  }
}
