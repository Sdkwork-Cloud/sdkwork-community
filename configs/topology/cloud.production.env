# cloud.production
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=cloud
SDKWORK_COMMUNITY_ENVIRONMENT=production
SDKWORK_COMMUNITY_PROFILE_ID=cloud.production
SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
VITE_SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
