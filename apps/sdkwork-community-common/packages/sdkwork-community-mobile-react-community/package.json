{
  "name": "@sdkwork/community-mobile-react-community",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Planned mobile React Community UI for capabilities not yet exposed by the canonical Community App API.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run apps/sdkwork-community-common/packages/sdkwork-community-mobile-react-community/src/services/CommunityService.test.ts --root ../../../.. --config vitest.config.ts --configLoader native --pool vmThreads",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sdkwork/ui-mobile-react": "workspace:*",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "sdkwork": {
    "workspace": "sdkwork-community",
    "architecture": "mobile-react",
    "domain": "community",
    "capability": "community",
    "status": "planned"
  }
}
