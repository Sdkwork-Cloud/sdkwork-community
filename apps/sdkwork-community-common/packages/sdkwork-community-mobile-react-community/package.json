{
  "name": "@sdkwork/community-mobile-react-community",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Community (圈子) mobile React UI for the sdkwork-community module: community circles, posts, comments, members, groups, QR codes and payments.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run apps/sdkwork-community-common/packages/sdkwork-community-mobile-react-community/src/services/CommunityService.test.ts --root ../../../.. --config vitest.config.ts --configLoader native --pool vmThreads",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sdkwork/community-contracts": "workspace:*",
    "@sdkwork/community-sdk-ports": "workspace:*",
    "@sdkwork/order-mobile-react-orders": "workspace:*",
    "@sdkwork/ui-mobile-react": "workspace:*",
    "@sdkwork/utils": "workspace:*",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "html-to-image": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "qrcode.react": "catalog:",
    "react-easy-crop": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "sdkwork": {
    "workspace": "sdkwork-community",
    "architecture": "mobile-react",
    "domain": "community",
    "capability": "community",
    "status": "implemented"
  }
